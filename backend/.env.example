# Django Secret Key (Generate a random one or use default for development)
SECRET_KEY=django-insecure-zenflow-dev-secret-key-change-in-prod

# Debug Mode
DEBUG=True

# Database Configuration (PostgreSQL)
DB_NAME=zenflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration (Gmail SMTP - optional in dev; if left empty, emails will print to terminal console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=
