# Django Secret Key (Generate a random one or use default for development)
SECRET_KEY=django-insecure-zenflow-dev-secret-key-change-in-prod

# Debug Mode
DEBUG=True

# Database Configuration (PostgreSQL)
# Either a single DATABASE_URL (used by Docker/CI/Render) ...
# DATABASE_URL=postgres://zenflow:zenflow@localhost:5432/zenflow
# ... or the individual settings below.
DB_NAME=zenflow_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s). FRONTEND_URL is used to build password-recovery links and
# is automatically added to CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS.
# In production, ensure https://zenflowbd.vercel.app is included.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://zenflowbd.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://zenflowbd.vercel.app

# JWT session cookies (httpOnly). Defaults: Secure + SameSite=None when
# DEBUG=False (cross-site Netlify -> Render), Lax + not Secure when DEBUG=True.
# Prefer a same-site deployment (app.example.com + api.example.com, or the
# Next.js proxy) with SameSite=Lax - see README "Production Deployment".
# JWT_AUTH_COOKIE_SECURE=True
# JWT_AUTH_COOKIE_SAMESITE=Lax
# JWT_AUTH_COOKIE_DOMAIN=
# CSRF cookie domain. Keep unset / empty for cross-origin deployments (host-only cookie on Render).
# CSRF_COOKIE_DOMAIN=
# Opt-in: reject *access* tokens as soon as the password changes. Signs every
# current user out once when first enabled.
# JWT_CHECK_REVOKE_TOKEN=False

# Password recovery (email reset link)
PASSWORD_RESET_TIMEOUT=3600
# Per-IP limits. password_recovery covers forgot + validate + confirm;
# auth covers email/password login and Google sign-in.
PASSWORD_RECOVERY_THROTTLE=20/hour
AUTH_THROTTLE=30/minute
# Shared cache for throttle counters across workers (falls back to in-memory
# per-process cache when unset). Defaults to REDIS_URL when that is set.
# CACHE_URL=redis://localhost:6379/1

# Email Configuration (Gmail SMTP - optional in dev; if left empty, emails will print to terminal console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Alternative transactional providers (optional)
# RESEND_API_KEY=
# BREVO_API_KEY=

# Google OAuth Client ID - REQUIRED for Google sign-in. The backend only accepts
# Google ID tokens whose audience equals this value and refuses Google sign-in
# entirely while it is empty. Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Reminders scheduler (Celery + Redis). Leave the defaults for local dev.
# Without Redis, run `python manage.py fire_due_reminders` from cron instead.
CELERY_BROKER_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline (no broker) - handy for tests / single-process dev.
CELERY_TASK_ALWAYS_EAGER=False
REMINDER_DISPATCH_INTERVAL_SECONDS=60
# Email delivery attempts per reminder before it is marked "failed".
REMINDER_EMAIL_MAX_ATTEMPTS=5
