# Base URL of the Django API (no trailing slash). The browser sends the
# httpOnly session cookies to this origin, so it must be listed in the
# backend's CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS as well.
# Set to "/" to call the frontend's own origin (requires API_PROXY_TARGET).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional same-origin proxy (build-time, server side). When set, Next.js
# rewrites /api/* and /media/* to this backend so session cookies are
# first-party even if the frontend and API are on different hosts.
# See README "Production Deployment".
# API_PROXY_TARGET=https://zenflow-xxxx.onrender.com

# Google OAuth Client ID. Must equal the backend's GOOGLE_CLIENT_ID - the
# backend verifies the Google ID token's audience against it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
