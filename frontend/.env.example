# Base URL of the Django API (no trailing slash).
# In local development, defaults to http://localhost:8000.
# In production, leave empty or set to "/" so browser calls default to the
# same-origin Next.js proxy (/api/*). This ensures cookies (session JWTs and CSRF)
# are treated as first-party by Safari/ITP and are never blocked.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Upstream target for the same-origin proxy (server-side).
# Defaults to https://zenflow-5u3r.onrender.com in production and http://127.0.0.1:8000 in dev.
# Set this in Vercel to override the upstream destination if using a custom backend domain.
API_PROXY_TARGET=https://zenflow-5u3r.onrender.com

# Google OAuth Client ID. Must equal the backend's GOOGLE_CLIENT_ID - the
# backend verifies the Google ID token's audience against it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
